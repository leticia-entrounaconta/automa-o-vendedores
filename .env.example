COMPOSE_PROJECT_NAME=RP

# Docker / display configuration
TZ=America/Sao_Paulo
NOVNC_PORT_HOST=7900
NOVNC_PORT=7900
VNC_PORT=5900
SCREEN_RESOLUTION=1280x720x24
LOGS_DIR=/app/logs
LOGS_DIR_HOST=./logs
ENABLE_VNC=false
APP_MODULE=app.main
CHROME_BINARY=/usr/bin/google-chrome
PRODUCAO_ENABLED=false
HEADLESS=false
PRODUCAO_DIAS_HISTORICO=120
DIAS_ATENCAO=15
DIAS_REATIVACAO=30
# Preencha somente após confirmar os nomes de status reais exportados pela 2Tech.
STATUS_PRODUCAO_VALIDA=
# Ordem usada para a data analítica de cada proposta.
PRIORIDADE_DATA_PRODUCAO=pagamento,producao,digitacao
# URLs
BASE_URL_2TECH=
# Compatibilidade com a configuração anterior:
URL_2TECH=
DOWNLOAD_PATH=data/downloads
OUTPUT_PATH=data/output



# URL do Relatório Geral. A automação usa este valor por padrão; altere apenas
# se a plataforma disponibilizar uma URL diferente no futuro.
RELATORIO_GERAL_URL=https://app1.gerencialcredito.com.br/Entrounaconta/relatorioRanking.asp
# Nome anterior mantido por compatibilidade. Tem prioridade menor que o acima.
RELATORIO_PRODUCAO_URL=

# Credenciais
USUARIO_2TECH=
SENHA_2TECH=
# Compatibilidade com a configuração anterior:
LOGIN2TECH=
PASSWORD2TECH=
LOGIN=
PASSWORD=
WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Esperas específicas por operação (segundos)
WAIT_PADRAO=20
WAIT_RELATORIO=60
WAIT_DOWNLOAD=120
MAX_TENTATIVAS=3
PAGE_LOAD_TIMEOUT=60

# SharePoint / Microsoft Graph
SHAREPOINT_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=entrounaconta.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Tienc
# Opcional: vazio usa a biblioteca padrão do site.
SHAREPOINT_LIBRARY=
SHAREPOINT_FOLDER=
