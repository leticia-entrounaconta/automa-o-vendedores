COMPOSE_PROJECT_NAME=rpa-template

# Docker / display configuration
TZ=America/Sao_Paulo
NOVNC_PORT_HOST=7900
NOVNC_PORT=7900
VNC_PORT=5900
SCREEN_RESOLUTION=1280x720x24
LOGS_DIR=/app/logs
LOGS_DIR_HOST=./logs
ENABLE_VNC=false
APP_MODULE=app.main
CHROME_BINARY=/usr/bin/google-chrome

# URLs
URL=https://www.example.com/portal
URL_2TECH=https://www.example.com/portal

# Credenciais
LOGIN=login
PASSWORD=password
LOGIN2TECH=login_2tech
PASSWORD2TECH=password_2tech
WEBHOOK_URL=https://www.example.com/webhook

# MS Graph variables
APP_ID=APP_ID
SECRET_KEY=SECRET_KEY
TENANT_ID=TENANT_ID
GROUP_ID=GROUP_ID

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
